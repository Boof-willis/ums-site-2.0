---
import Icon from "@/components/Icon.astro";
interface Props {
  items: { name: string; url: string }[];
  dark?: boolean;
}
const { items, dark = false } = Astro.props;
---
<nav aria-label="Breadcrumb" class="container-page py-4">
  <ol class:list={["flex flex-wrap items-center gap-1 text-sm", dark ? "text-navy-200" : "text-navy-500"]}>
    {items.map((it, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <Icon name="chevron" class="h-4 w-4 -rotate-90 opacity-50" />}
        {i < items.length - 1 ? (
          <a href={it.url} class:list={["hover:underline", dark ? "hover:text-white" : "hover:text-canyon-700"]}>{it.name}</a>
        ) : (
          <span class:list={["font-medium", dark ? "text-white" : "text-navy-800"]} aria-current="page">{it.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
