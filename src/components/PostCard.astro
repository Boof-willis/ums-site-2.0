---
import type { Post } from "@/lib/blog";
import { categorySlug, fmtDate } from "@/lib/blog";
interface Props { post: Post; }
const { post } = Astro.props;
const { title, description, pubDate, category } = post.data;
---
<article
  class="post-card group relative flex flex-col rounded-2xl border border-navy-100 bg-white p-6 transition-all hover:-translate-y-1 hover:border-canyon-200 hover:shadow-xl"
  data-category={categorySlug(category)}
>
  <a href={`/blog/category/${categorySlug(category)}/`} class="relative z-10 text-xs font-semibold uppercase tracking-wider text-canyon-700 hover:underline">{category}</a>
  <h3 class="mt-2 text-lg font-bold leading-snug">
    <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0 group-hover:text-canyon-700">{title}</a>
  </h3>
  <p class="mt-2 flex-1 text-sm text-navy-600 line-clamp-3">{description}</p>
  <div class="mt-4 flex items-center justify-between text-xs text-navy-400">
    <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
    <a href={`/blog/${post.id}/`} class="font-semibold text-canyon-700">Read →</a>
  </div>
</article>
