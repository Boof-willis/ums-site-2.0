---
import Icon from "@/components/Icon.astro";
import { BUSINESS } from "@/consts";
---
<aside class="mt-12 rounded-2xl border border-navy-100 bg-sand-50 p-6">
  <div class="flex items-start gap-4">
    <span class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-navy-900 text-canyon-400">
      <Icon name="truck" class="h-7 w-7" />
    </span>
    <div>
      <h3 class="font-bold text-navy-900">Derek Martin</h3>
      <p class="text-xs font-medium text-canyon-700">Founder & Owner, Utah's Moving and Storage</p>
      <p class="mt-1.5 text-sm text-navy-600">
        Derek founded Utah's Moving and Storage, a family-owned, fully licensed
        Utah moving company (#{BUSINESS.license}), and has overseen thousands of
        local and long-distance moves across the Wasatch Front. He and his crew
        share hard-earned, on-the-job moving knowledge so your next move is
        easier, whether you hire movers or do it yourself.
      </p>
      <a href="/about/" class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-canyon-700">
        Meet the team <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </div>
</aside>
