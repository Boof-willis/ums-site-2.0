---
import { BUSINESS } from "@/consts";
import Icon from "@/components/Icon.astro";
interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = "Ready for a stress-free move?",
  text = "Get a fast, no-obligation quote from Utah's most trusted local movers.",
} = Astro.props;
---
<section class="container-page my-20">
  <div class="relative overflow-hidden rounded-3xl bg-navy-900 px-6 py-14 text-center sm:px-12">
    <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-canyon-500/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-20 -left-10 h-64 w-64 rounded-full bg-navy-500/30 blur-3xl"></div>
    <div class="relative mx-auto max-w-2xl">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">{heading}</h2>
      <p class="mt-4 text-lg text-navy-200">{text}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/quote/" class="btn-primary w-full sm:w-auto">Get a Free Quote</a>
        <a href={BUSINESS.phoneHref} class="btn-ghost-light w-full sm:w-auto">
          <Icon name="phone" class="h-5 w-5" /> Call {BUSINESS.phone}
        </a>
      </div>
    </div>
  </div>
</section>
