---
import { BUSINESS, PRIMARY_NAV } from "@/consts";
import Icon from "@/components/Icon.astro";
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---
<header class="sticky top-0 z-40 border-b border-navy-100 bg-white/90 backdrop-blur-md">
  <div class="container-page flex h-18 items-center justify-between gap-4 py-3">
    <!-- Logo -->
    <a href="/" class="flex shrink-0 items-center" aria-label={`${BUSINESS.legalName} home`}>
      <img
        src="/images/logo-navy.png"
        alt={`${BUSINESS.legalName} logo`}
        width="201"
        height="44"
        class="h-9 w-auto sm:h-10"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {PRIMARY_NAV.map((item) =>
        "children" in item && item.children ? (
          <div class="group relative">
            <a
              href={item.href}
              class:list={[
                "flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium transition-colors",
                isActive(item.href) ? "text-canyon-700" : "text-navy-700 hover:text-canyon-700",
              ]}
            >
              {item.label}
              <Icon name="chevron" class="h-4 w-4 transition-transform group-hover:rotate-180" />
            </a>
            <div class="invisible absolute left-0 top-full pt-2 opacity-0 transition-all group-hover:visible group-hover:opacity-100">
              <ul class="w-56 rounded-xl border border-navy-100 bg-white p-2 shadow-xl">
                {item.children.map((c) => (
                  <li>
                    <a
                      href={c.href}
                      class="block rounded-lg px-3 py-2 text-sm text-navy-700 hover:bg-sand-100 hover:text-canyon-700"
                    >
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[
              "rounded-lg px-3 py-2 text-sm font-medium transition-colors",
              isActive(item.href) ? "text-canyon-700" : "text-navy-700 hover:text-canyon-700",
            ]}
          >
            {item.label}
          </a>
        )
      )}
    </nav>

    <!-- CTAs -->
    <div class="flex items-center gap-2">
      <a
        href={BUSINESS.phoneHref}
        class="hidden items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-navy-800 hover:text-canyon-700 sm:flex"
      >
        <Icon name="phone" class="h-4 w-4 text-canyon-500" />
        {BUSINESS.phone}
      </a>
      <a href="/quote/" class="btn-primary hidden text-sm sm:inline-flex">Free Quote</a>
      <button
        type="button"
        id="menu-toggle"
        class="rounded-lg p-2 text-navy-800 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-navy-100 bg-white lg:hidden">
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Mobile">
      {PRIMARY_NAV.map((item) => (
        <a href={item.href} class="rounded-lg px-3 py-2.5 font-medium text-navy-800 hover:bg-sand-100">
          {item.label}
        </a>
      ))}
      <div class="mt-3 flex flex-col gap-2">
        <a href={BUSINESS.phoneHref} class="btn-secondary">
          <Icon name="phone" class="h-4 w-4" /> {BUSINESS.phone}
        </a>
        <a href="/quote/" class="btn-primary">Get a Free Quote</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(open === false));
  });
</script>

<style>
  .h-18 { height: 4.5rem; }
</style>
