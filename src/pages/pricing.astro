---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import Faq from "@/components/Faq.astro";
import CtaBand from "@/components/CtaBand.astro";
import { SERVICE_CONTENT } from "@/data/services";
import { breadcrumbNode, faqNode } from "@/lib/schema";

const crumbs = [
  { name: "Home", url: "/" },
  { name: "Pricing", url: "/pricing/" },
];

const tiers = SERVICE_CONTENT.residential.pricing!;

const otherPricing = [
  { title: "Long-Distance Moves", price: "Personalized quote", points: ["Set travel costs (no surprise mileage)", "No cargo transfers", "Trained professional crew", "Priced by inventory, distance & timeline"], href: "/services/long-distance/" },
  { title: "Commercial & Office", price: "Personalized quote", points: ["Priced by space size & equipment", "After-hours & weekend scheduling", "Minimal business downtime", "Storage coordination available"], href: "/services/commercial/" },
  { title: "Packing & Supplies", price: "From box pricing", points: ["Small, medium, large & XL boxes", "Bubble wrap, tape & packing foam", "Specialty boxes for fragile items", "Full-service or partial packing"], href: "/services/packing/" },
];

const pricingFaqs = [
  { q: "How much does a move cost in Utah?", a: "Local moves with Utah's Moving and Storage start at <strong>$140/hour</strong> for two movers and a fully equipped truck, with a 3-hour minimum and $40/hour per additional mover. Long-distance, commercial, and specialty moves are quoted individually. You always get a clear quote before booking — with no hidden fees." },
  { q: "What's included in the hourly rate?", a: "Your hourly rate includes two trained movers, the truck, moving blankets, disassembly and reassembly, plastic wrap, dollies, lifting straps, tools, tie-downs, a free virtual walkthrough, and basic carrier liability. There are no hidden equipment or fuel surcharges." },
  { q: "Is there a minimum charge?", a: "Yes — local and labor-only moves have a 3-hour minimum. This ensures your crew has the time to protect and move your belongings properly." },
  { q: "Do you charge for travel time?", a: "Local moves include a truck charge (or dispatch fee for labor-only). Long-distance moves use set travel costs quoted up front, so you're never billed open-ended mileage at the end." },
  { q: "Are there any hidden fees?", a: "No. The quote we give you is the price you pay. We don't pass weather or traffic delays on to you, and we don't add surprise charges at the end of the job." },
];

const schema = [breadcrumbNode(crumbs), faqNode(pricingFaqs)];
---
<BaseLayout
  title="Moving Company Pricing in Utah | Transparent Rates from $140/hr"
  description="Honest, transparent moving prices in Utah. Local moves from $140/hour (2 movers + truck), plus long-distance, commercial & packing quotes. No hidden fees."
  path="/pricing/"
  schema={schema}
  isFAQ
>
  <section class="bg-navy-950">
    <Breadcrumbs items={crumbs} dark />
    <div class="container-page pb-14 pt-6">
      <h1 class="text-3xl font-bold text-white sm:text-4xl lg:text-5xl">Transparent moving prices, no hidden fees</h1>
      <p class="mt-5 max-w-2xl text-lg text-navy-200">Local moves start at <strong class="text-white">$140/hour</strong> for two movers and a fully equipped truck. Here's exactly what you get — and what everything costs.</p>
    </div>
  </section>

  <!-- Residential tiers -->
  <section class="container-page py-16">
    <h2 class="text-2xl font-bold sm:text-3xl">Residential moving rates</h2>
    <div class="mt-8 grid gap-6 lg:grid-cols-3">
      {tiers.map((tier) => (
        <div class="flex flex-col rounded-2xl border border-navy-100 bg-white p-7 shadow-sm">
          <h3 class="font-display text-lg font-bold">{tier.name}</h3>
          <div class="mt-3 flex items-baseline gap-1">
            <span class="font-display text-4xl font-bold text-navy-900">{tier.price}</span>
            {tier.unit && <span class="text-sm text-navy-500">{tier.unit}</span>}
          </div>
          {tier.note && <p class="mt-2 text-xs text-navy-500">{tier.note}</p>}
          <ul class="mt-5 space-y-2.5 text-sm text-navy-700">
            {tier.features.map((f) => (
              <li class="flex items-start gap-2"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-canyon-500" />{f}</li>
            ))}
          </ul>
          <a href="/quote/" class="btn-primary mt-6 w-full text-sm">Get this quote</a>
        </div>
      ))}
    </div>
  </section>

  <!-- Other services pricing -->
  <section class="bg-sand-50 py-16">
    <div class="container-page">
      <h2 class="text-2xl font-bold sm:text-3xl">Long-distance, commercial & packing</h2>
      <p class="mt-3 max-w-2xl text-navy-600">These moves vary too much for a single rate, so we build a personalized quote around your exact needs — always up front, never a surprise.</p>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        {otherPricing.map((o) => (
          <div class="flex flex-col rounded-2xl border border-navy-100 bg-white p-7">
            <h3 class="font-display text-lg font-bold">{o.title}</h3>
            <div class="mt-2 font-display text-xl font-bold text-canyon-600">{o.price}</div>
            <ul class="mt-5 space-y-2.5 text-sm text-navy-700">
              {o.points.map((p) => (
                <li class="flex items-start gap-2"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-canyon-500" />{p}</li>
              ))}
            </ul>
            <a href={o.href} class="btn-secondary mt-6 w-full text-sm">Learn more</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Value props -->
  <section class="container-page py-16">
    <div class="grid gap-6 sm:grid-cols-3">
      {[
        { icon: "check-circle", title: "No hidden fees", text: "The quote we give is the price you pay — guaranteed." },
        { icon: "quote", title: "Free virtual walkthrough", text: "An accurate estimate before you ever commit." },
        { icon: "shield", title: "Licensed & insured", text: "Carrier liability included on every single move." },
      ].map((v) => (
        <div class="rounded-2xl border border-navy-100 p-6">
          <Icon name={v.icon} class="h-7 w-7 text-canyon-500" />
          <h3 class="mt-3 font-bold">{v.title}</h3>
          <p class="mt-2 text-sm text-navy-600">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <Faq items={pricingFaqs} heading="Pricing questions, answered" />
  <CtaBand heading="Get your exact price in minutes" />
</BaseLayout>
