---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import Stars from "@/components/Stars.astro";
import QuoteForm from "@/components/QuoteForm.astro";
import { BUSINESS } from "@/consts";
import { breadcrumbNode } from "@/lib/schema";

const crumbs = [
  { name: "Home", url: "/" },
  { name: "Free Quote", url: "/quote/" },
];
const benefits = [
  "Free, no-obligation estimate",
  "Free virtual walkthrough for accuracy",
  "No hidden fees, ever",
  "Licensed & insured Utah movers",
  "Reply within a few business hours",
];
---
<BaseLayout
  title="Get a Free Moving Quote in Utah | Utah's Moving and Storage"
  description="Get a free, no-obligation moving quote from Utah's Moving and Storage. Local, long-distance, commercial & packing across the Wasatch Front. No hidden fees."
  path="/quote/"
  schema={[breadcrumbNode(crumbs)]}
>
  <section class="bg-navy-950">
    <Breadcrumbs items={crumbs} dark />
    <div class="container-page grid gap-12 pb-16 pt-6 lg:grid-cols-2 lg:items-start">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-sm text-navy-100">
          <Stars class="h-4 w-4" /> <span><strong class="text-white">{BUSINESS.rating.value}</strong> from {BUSINESS.rating.count}+ reviews</span>
        </div>
        <h1 class="mt-5 text-3xl font-bold text-white sm:text-4xl lg:text-5xl">Get your free moving quote</h1>
        <p class="mt-5 text-lg text-navy-200">Fill out the form and we'll get back to you fast with a clear, no-obligation estimate. Prefer to talk? Call us anytime at {BUSINESS.phone}.</p>
        <ul class="mt-8 space-y-3">
          {benefits.map((b) => (
            <li class="flex items-center gap-3 text-navy-100"><Icon name="check-circle" class="h-5 w-5 text-canyon-400" />{b}</li>
          ))}
        </ul>
        <a href={BUSINESS.phoneHref} class="btn-ghost-light mt-8"><Icon name="phone" class="h-5 w-5" /> Call {BUSINESS.phone}</a>
      </div>
      <div class="rounded-2xl bg-white p-7 shadow-2xl sm:p-8">
        <h2 class="text-xl font-bold">Tell us about your move</h2>
        <div class="mt-5"><QuoteForm source="quote-page" /></div>
      </div>
    </div>
  </section>
</BaseLayout>
