---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import CtaBand from "@/components/CtaBand.astro";
import { breadcrumbNode } from "@/lib/schema";

const guides = (await getCollection("guides")).sort(
  (a, b) => a.data.order - b.data.order
);
const crumbs = [
  { name: "Home", url: "/" },
  { name: "Moving Guide", url: "/moving-guide/" },
];
---
<BaseLayout
  title="The Ultimate Utah Moving Guide | Checklists & Expert Tips"
  description="Free moving guides and checklists from Utah's Moving and Storage — residential, long-distance, and office prep, plus moving-week, moving-day, and packing advice."
  path="/moving-guide/"
  schema={[breadcrumbNode(crumbs)]}
>
  <section class="bg-navy-950">
    <Breadcrumbs items={crumbs} dark />
    <div class="container-page pb-14 pt-6">
      <h1 class="text-3xl font-bold text-white sm:text-4xl lg:text-5xl">The ultimate Utah moving guide</h1>
      <p class="mt-5 max-w-2xl text-lg text-navy-200">We've completed thousands of moves. This six-part guide shares the hard-earned knowledge that makes moving day go smoothly — whether you hire us or do it yourself.</p>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {guides.map((g, i) => (
        <a href={`/moving-guide/${g.id}/`} class="group flex flex-col rounded-2xl border border-navy-100 bg-white p-7 transition-all hover:-translate-y-1 hover:border-canyon-200 hover:shadow-xl">
          <span class="font-display text-3xl font-bold text-sand-200">{String(i + 1).padStart(2, "0")}</span>
          <h2 class="mt-3 text-xl font-bold">{g.data.title}</h2>
          <p class="mt-2 flex-1 text-sm text-navy-600">{g.data.description}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-canyon-700">Read the guide <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
        </a>
      ))}
    </div>
  </section>

  <CtaBand heading="Rather skip the checklist? Let us handle it." />
</BaseLayout>
