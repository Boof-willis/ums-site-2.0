---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import CtaBand from "@/components/CtaBand.astro";
import { breadcrumbNode } from "@/lib/schema";

export async function getStaticPaths() {
  const guides = (await getCollection("guides")).sort(
    (a, b) => a.data.order - b.data.order
  );
  return guides.map((g, i) => ({
    params: { slug: g.id },
    props: { g, prev: guides[i - 1], next: guides[i + 1] },
  }));
}

const { g, prev, next } = Astro.props;
const { Content } = await render(g);
const path = `/moving-guide/${g.id}/`;
const crumbs = [
  { name: "Home", url: "/" },
  { name: "Moving Guide", url: "/moving-guide/" },
  { name: g.data.title, url: path },
];
---
<BaseLayout
  title={`${g.data.title} | Utah's Moving and Storage`}
  description={g.data.description}
  path={path}
  ogType="article"
  schema={[breadcrumbNode(crumbs)]}
>
  <Breadcrumbs items={crumbs} />
  <article class="container-page pb-8">
    <div class="mx-auto max-w-3xl">
      <p class="font-semibold uppercase tracking-wider text-canyon-600">Moving Guide</p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl lg:text-5xl">{g.data.title}</h1>
      <p class="mt-4 text-lg text-navy-600">{g.data.description}</p>
      <div class="prose-ums mt-10 max-w-none">
        <Content />
      </div>
    </div>
  </article>

  <nav class="container-page my-12" aria-label="Guide navigation">
    <div class="mx-auto flex max-w-3xl justify-between gap-4 border-t border-navy-100 pt-6 text-sm">
      {prev ? (
        <a href={`/moving-guide/${prev.id}/`} class="group flex items-center gap-2 text-navy-700 hover:text-canyon-700">
          <Icon name="arrow" class="h-4 w-4 rotate-180" /> {prev.data.title}
        </a>
      ) : <span />}
      {next ? (
        <a href={`/moving-guide/${next.id}/`} class="group flex items-center gap-2 text-right text-navy-700 hover:text-canyon-700">
          {next.data.title} <Icon name="arrow" class="h-4 w-4" />
        </a>
      ) : <span />}
    </div>
  </nav>

  <CtaBand />
</BaseLayout>
