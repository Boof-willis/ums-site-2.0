---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import CtaBand from "@/components/CtaBand.astro";
import { SERVICES } from "@/consts";
import { SERVICE_CONTENT } from "@/data/services";
import { breadcrumbNode } from "@/lib/schema";

const crumbs = [
  { name: "Home", url: "/" },
  { name: "Services", url: "/services/" },
];
---
<BaseLayout
  title="Moving Services in Utah | Residential, Long-Distance & Commercial"
  description="Explore moving services from Utah's Moving and Storage: residential, long-distance, commercial, and professional packing across the Wasatch Front."
  path="/services/"
  schema={[breadcrumbNode(crumbs)]}
>
  <section class="bg-navy-950">
    <Breadcrumbs items={crumbs} dark />
    <div class="container-page pb-14 pt-6">
      <h1 class="text-3xl font-bold text-white sm:text-4xl lg:text-5xl">Moving services for every kind of move</h1>
      <p class="mt-5 max-w-2xl text-lg text-navy-200">Whether you're moving across town, across the country, or relocating your business, we tailor every move to exactly what you need, with careful crews and honest pricing.</p>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid gap-8 lg:grid-cols-2">
      {SERVICES.map((s) => {
        const c = SERVICE_CONTENT[s.key];
        return (
          <a href={`/services/${s.key}/`} class="group flex flex-col rounded-2xl border border-navy-100 bg-white p-8 transition-all hover:-translate-y-1 hover:border-canyon-200 hover:shadow-xl">
            <span class="grid h-14 w-14 place-items-center rounded-xl bg-navy-900 text-canyon-400 group-hover:bg-canyon-500 group-hover:text-white">
              <Icon name={s.icon} class="h-7 w-7" />
            </span>
            <h2 class="mt-5 text-2xl font-bold">{s.title}</h2>
            <p class="mt-3 text-navy-600">{c.lead}</p>
            <span class="mt-5 inline-flex items-center gap-1 font-semibold text-canyon-700">
              Learn more <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <CtaBand />
</BaseLayout>
