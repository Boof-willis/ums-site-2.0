---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import Faq from "@/components/Faq.astro";
import CtaBand from "@/components/CtaBand.astro";
import QuoteForm from "@/components/QuoteForm.astro";
import { SERVICE_CONTENT } from "@/data/services";
import { SERVICES } from "@/consts";
import { serviceNode, faqNode, breadcrumbNode } from "@/lib/schema";

export function getStaticPaths() {
  return Object.values(SERVICE_CONTENT).map((s) => ({
    params: { service: s.key },
    props: { s },
  }));
}

const { s } = Astro.props;
const path = `/services/${s.key}/`;
const crumbs = [
  { name: "Home", url: "/" },
  { name: "Services", url: "/services/" },
  { name: s.title, url: path },
];
const others = SERVICES.filter((x) => x.key !== s.key);

const schema = [
  serviceNode({ name: s.title, url: path, description: s.lead }),
  faqNode(s.faqs),
  breadcrumbNode(crumbs),
];
---

<BaseLayout
  title={s.seoTitle}
  description={s.seoDescription}
  path={path}
  schema={schema}
  isFAQ
>
  <!-- Hero -->
  <section class="bg-navy-950">
    <Breadcrumbs items={crumbs} dark />
    <div class="container-page grid gap-12 pb-16 pt-6 lg:grid-cols-[1.3fr_1fr] lg:items-start">
      <div>
        <h1 class="text-3xl font-bold text-white sm:text-4xl lg:text-5xl">{s.h1}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-navy-200">{s.lead}</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href="/quote/" class="btn-primary">Get a Free Quote <Icon name="arrow" class="h-5 w-5" /></a>
          <a href="/pricing/" class="btn-ghost-light">See pricing</a>
        </div>
      </div>
      <div class="rounded-2xl bg-white p-6 shadow-2xl">
        <h2 class="text-lg font-bold">Free quote for your {s.title.toLowerCase()}</h2>
        <div class="mt-4"><QuoteForm compact source={`service-${s.key}`} /></div>
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="container-page py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {s.highlights.map((h) => (
        <div class="rounded-2xl border border-navy-100 bg-white p-6">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-canyon-50 text-canyon-600">
            <Icon name={h.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-4 font-bold">{h.title}</h3>
          <p class="mt-2 text-sm text-navy-600">{h.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Body -->
  <section class="container-page pb-8">
    <div class="mx-auto max-w-3xl prose-ums text-lg">
      {s.intro.map((p) => <p>{p}</p>)}
      {s.sections.map((sec) => (
        <>
          <h2>{sec.h2}</h2>
          {sec.body.map((p) => <p>{p}</p>)}
        </>
      ))}
    </div>
  </section>

  <!-- Pricing (if any) -->
  {s.pricing && (
    <section class="container-page py-12">
      <h2 class="text-center text-3xl font-bold">{s.title} pricing</h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-navy-600">Transparent pricing with no hidden fees. Every move includes a free virtual walkthrough.</p>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {s.pricing.map((tier) => (
          <div class="flex flex-col rounded-2xl border border-navy-100 bg-white p-7 shadow-sm">
            <h3 class="font-display text-lg font-bold">{tier.name}</h3>
            <div class="mt-3 flex items-baseline gap-1">
              <span class="font-display text-4xl font-bold text-navy-900">{tier.price}</span>
              {tier.unit && <span class="text-sm text-navy-500">{tier.unit}</span>}
            </div>
            {tier.note && <p class="mt-2 text-xs text-navy-500">{tier.note}</p>}
            <ul class="mt-5 space-y-2.5 text-sm text-navy-700">
              {tier.features.map((f) => (
                <li class="flex items-start gap-2"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-canyon-500" />{f}</li>
              ))}
            </ul>
            <a href="/quote/" class="btn-primary mt-6 w-full text-sm">Get this quote</a>
          </div>
        ))}
      </div>
    </section>
  )}

  <Faq items={s.faqs} heading={`${s.title} FAQs`} />

  <!-- Other services -->
  <section class="container-page py-12">
    <h2 class="text-2xl font-bold">Explore our other services</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-3">
      {others.map((o) => (
        <a href={`/services/${o.key}/`} class="group rounded-2xl border border-navy-100 bg-white p-6 transition-all hover:-translate-y-1 hover:border-canyon-200 hover:shadow-lg">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-navy-900 text-canyon-400 group-hover:bg-canyon-500 group-hover:text-white">
            <Icon name={o.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-4 font-bold">{o.title}</h3>
          <p class="mt-2 text-sm text-navy-600">{o.short}</p>
        </a>
      ))}
    </div>
  </section>

  <CtaBand heading={`Get your free ${s.title.toLowerCase()} quote`} />
</BaseLayout>
