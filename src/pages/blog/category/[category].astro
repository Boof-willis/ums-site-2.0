---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PostCard from "@/components/PostCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import { getPublishedPosts, categorySlug } from "@/lib/blog";
import { breadcrumbNode } from "@/lib/schema";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const map = new Map<string, { name: string; posts: typeof posts }>();
  for (const p of posts) {
    const slug = categorySlug(p.data.category);
    if (!map.has(slug)) map.set(slug, { name: p.data.category, posts: [] });
    map.get(slug)!.posts.push(p);
  }
  return [...map.entries()].map(([slug, { name, posts }]) => ({
    params: { category: slug },
    props: { name, posts },
  }));
}

const { name, posts } = Astro.props;
const path = `/blog/category/${categorySlug(name)}/`;
const crumbs = [
  { name: "Home", url: "/" },
  { name: "Blog", url: "/blog/" },
  { name, url: path },
];
---
<BaseLayout
  title={`${name}, Moving Tips | Utah's Moving and Storage`}
  description={`${name} articles and advice from Utah's Moving and Storage, a 4.9-star Utah moving company. ${posts.length} expert guides.`}
  path={path}
  schema={[breadcrumbNode(crumbs)]}
>
  <section class="bg-navy-950">
    <Breadcrumbs items={crumbs} dark />
    <div class="container-page pb-14 pt-6">
      <p class="font-semibold uppercase tracking-wider text-canyon-400">Category</p>
      <h1 class="mt-2 text-3xl font-bold text-white sm:text-4xl lg:text-5xl">{name}</h1>
      <p class="mt-4 text-navy-200">{posts.length} {posts.length === 1 ? "article" : "articles"}</p>
    </div>
  </section>

  <section class="container-page py-12">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    <div class="mt-10">
      <a href="/blog/" class="font-semibold text-canyon-700">← All articles</a>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
