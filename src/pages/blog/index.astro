---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PostCard from "@/components/PostCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import { getPublishedPosts, categorySlug } from "@/lib/blog";
import { breadcrumbNode } from "@/lib/schema";

const posts = await getPublishedPosts();
const categories = [...new Set(posts.map((p) => p.data.category))].sort();
const crumbs = [
  { name: "Home", url: "/" },
  { name: "Blog", url: "/blog/" },
];
---
<BaseLayout
  title="Utah Moving Tips & Guides | Utah's Moving and Storage Blog"
  description="Expert moving tips, packing guides, and relocation advice from Utah's Moving and Storage, a 4.9-star local moving company serving the Wasatch Front."
  path="/blog/"
  schema={[breadcrumbNode(crumbs)]}
>
  <section class="bg-navy-950">
    <Breadcrumbs items={crumbs} dark />
    <div class="container-page pb-14 pt-6">
      <h1 class="text-3xl font-bold text-white sm:text-4xl lg:text-5xl">Moving tips &amp; guides</h1>
      <p class="mt-5 max-w-2xl text-lg text-navy-200">Hard-earned advice from a crew that's completed thousands of moves, packing, planning, and everything in between.</p>
    </div>
  </section>

  <section class="container-page py-12">
    <!-- Category filter -->
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
      <button type="button" class="cat-chip is-active rounded-full border border-navy-200 px-4 py-1.5 text-sm font-medium" data-cat="all">All</button>
      {categories.map((c) => (
        <button type="button" class="cat-chip rounded-full border border-navy-200 px-4 py-1.5 text-sm font-medium" data-cat={categorySlug(c)}>{c}</button>
      ))}
    </div>

    <div id="post-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    <p class="mt-6 text-sm text-navy-500">{posts.length} articles</p>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .cat-chip { transition: all .15s; }
  .cat-chip.is-active { background: var(--color-navy-900); color: #fff; border-color: var(--color-navy-900); }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".cat-chip");
  const cards = document.querySelectorAll<HTMLElement>(".post-card");
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const cat = chip.dataset.cat;
      chips.forEach((c) => c.classList.toggle("is-active", c === chip));
      cards.forEach((card) => {
        const show = cat === "all" || card.dataset.category === cat;
        card.style.display = show ? "" : "none";
      });
    });
  });
</script>
