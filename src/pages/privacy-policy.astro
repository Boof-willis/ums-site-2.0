---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { BUSINESS } from "@/consts";
import { breadcrumbNode } from "@/lib/schema";
const crumbs = [
  { name: "Home", url: "/" },
  { name: "Privacy Policy", url: "/privacy-policy/" },
];
const updated = "June 2, 2026";
---
<BaseLayout
  title="Privacy Policy | Utah's Moving and Storage"
  description="Privacy Policy for Utah's Moving and Storage describing what information we collect, how we use it, and your choices."
  path="/privacy-policy/"
  schema={[breadcrumbNode(crumbs)]}
>
  <Breadcrumbs items={crumbs} />
  <article class="container-page pb-16">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-3xl font-bold sm:text-4xl">Privacy Policy</h1>
      <p class="mt-2 text-sm text-navy-500">Last updated: {updated}</p>
      <div class="prose-ums mt-8">
        <p>{BUSINESS.legalName} ("we," "us," or "our") respects your privacy. This policy explains what information we collect through our website and services, how we use it, and the choices you have.</p>

        <h2>Information we collect</h2>
        <p>When you request a quote, contact us, or apply for a job, we collect the information you provide, such as your name, phone number, email address, move details, and any message you send. We also automatically collect basic technical data (like your IP address and browser type) and may use cookies and analytics tools to understand how our site is used.</p>

        <h2>How we use your information</h2>
        <ul>
          <li>To respond to your quote requests, questions, and applications</li>
          <li>To schedule, perform, and follow up on moving services</li>
          <li>To send service-related communications (e.g., arrival confirmations)</li>
          <li>To improve our website and services</li>
          <li>To comply with legal obligations</li>
        </ul>

        <h2>How we share information</h2>
        <p>We do not sell your personal information. We may share it with trusted service providers (such as our CRM, scheduling, and payment processors) who help us operate our business, and when required by law. These providers are only permitted to use your information to provide services to us.</p>

        <h2>Data retention</h2>
        <p>We keep your information only as long as needed to provide our services and meet legal, accounting, or reporting requirements.</p>

        <h2>Your choices</h2>
        <p>You may opt out of marketing messages at any time, and you can request access to, correction of, or deletion of your personal information by contacting us.</p>

        <h2>Contact us</h2>
        <p>Questions about this policy? Contact {BUSINESS.legalName} at <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a> or <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a>, {BUSINESS.address.street}, {BUSINESS.address.city}, {BUSINESS.address.region} {BUSINESS.address.postalCode}.</p>
      </div>
    </div>
  </article>
</BaseLayout>
