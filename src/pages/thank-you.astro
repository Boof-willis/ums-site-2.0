---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { BUSINESS } from "@/consts";
---
<BaseLayout
  title="Thank You | Utah's Moving and Storage"
  description="Thanks for reaching out to Utah's Moving and Storage. We'll be in touch shortly."
  path="/thank-you/"
  noindex
>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <span class="grid h-16 w-16 place-items-center rounded-full bg-canyon-50 text-canyon-600">
      <Icon name="check-circle" class="h-9 w-9" />
    </span>
    <h1 class="mt-6 text-3xl font-bold sm:text-4xl">Thanks — we've got your request!</h1>
    <p class="mt-4 max-w-lg text-lg text-navy-600">A member of our team will reach out within a few business hours. Need to talk sooner? Give us a call.</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={BUSINESS.phoneHref} class="btn-primary"><Icon name="phone" class="h-5 w-5" /> Call {BUSINESS.phone}</a>
      <a href="/" class="btn-secondary">Back to home</a>
    </div>
    <div class="mt-12">
      <p class="text-sm font-medium text-navy-500">While you wait, explore our moving guides:</p>
      <div class="mt-3 flex flex-wrap justify-center gap-3 text-sm">
        <a href="/moving-guide/" class="text-canyon-700 underline">Moving Guide</a>
        <a href="/blog/" class="text-canyon-700 underline">Moving Tips Blog</a>
        <a href="/pricing/" class="text-canyon-700 underline">Pricing</a>
      </div>
    </div>
  </section>
</BaseLayout>
