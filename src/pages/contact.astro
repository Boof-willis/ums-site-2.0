---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import QuoteForm from "@/components/QuoteForm.astro";
import { BUSINESS } from "@/consts";
import { breadcrumbNode } from "@/lib/schema";

const crumbs = [
  { name: "Home", url: "/" },
  { name: "Contact", url: "/contact/" },
];
const mapQuery = encodeURIComponent(
  `${BUSINESS.address.street}, ${BUSINESS.address.city}, ${BUSINESS.address.region} ${BUSINESS.address.postalCode}`
);
---
<BaseLayout
  title="Contact Utah's Moving and Storage | Get a Free Moving Quote"
  description="Contact Utah's Moving and Storage in Orem, UT. Call (801) 980-0223 or request a free quote online for local, long-distance, commercial & packing services."
  path="/contact/"
  schema={[breadcrumbNode(crumbs)]}
>
  <section class="bg-navy-950">
    <Breadcrumbs items={crumbs} dark />
    <div class="container-page pb-12 pt-6">
      <h1 class="text-3xl font-bold text-white sm:text-4xl lg:text-5xl">Let's plan your move</h1>
      <p class="mt-4 max-w-2xl text-lg text-navy-200">Call us, email us, or request a free quote below. We typically reply within a few business hours.</p>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr]">
      <!-- Details -->
      <div>
        <h2 class="text-2xl font-bold">Get in touch</h2>
        <ul class="mt-6 space-y-5">
          <li class="flex items-start gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-canyon-50 text-canyon-600"><Icon name="phone" class="h-5 w-5" /></span>
            <div>
              <div class="text-sm font-medium text-navy-500">Phone</div>
              <a href={BUSINESS.phoneHref} class="text-lg font-semibold text-navy-900 hover:text-canyon-700">{BUSINESS.phone}</a>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-canyon-50 text-canyon-600"><Icon name="mail" class="h-5 w-5" /></span>
            <div>
              <div class="text-sm font-medium text-navy-500">Email</div>
              <a href={`mailto:${BUSINESS.email}`} class="break-all text-lg font-semibold text-navy-900 hover:text-canyon-700">{BUSINESS.email}</a>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-canyon-50 text-canyon-600"><Icon name="map-pin" class="h-5 w-5" /></span>
            <div>
              <div class="text-sm font-medium text-navy-500">Address</div>
              <address class="not-italic text-lg font-semibold text-navy-900">{BUSINESS.address.street}, {BUSINESS.address.city}, {BUSINESS.address.region} {BUSINESS.address.postalCode}</address>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-canyon-50 text-canyon-600"><Icon name="clock" class="h-5 w-5" /></span>
            <div>
              <div class="text-sm font-medium text-navy-500">Hours</div>
              <div class="text-lg font-semibold text-navy-900">Monday-Saturday: 7am-7pm</div>
            </div>
          </li>
        </ul>
        <div class="mt-8 overflow-hidden rounded-2xl border border-navy-100">
          <iframe
            title="Utah's Moving and Storage location map"
            width="100%" height="280" loading="lazy" style="border:0;"
            referrerpolicy="no-referrer-when-downgrade"
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          ></iframe>
        </div>
      </div>

      <!-- Form -->
      <div class="rounded-2xl border border-navy-100 bg-white p-7 shadow-sm sm:p-8">
        <h2 class="text-2xl font-bold">Request a free quote</h2>
        <p class="mt-2 text-navy-600">Tell us about your move and we'll get right back to you.</p>
        <div class="mt-6"><QuoteForm source="contact-page" /></div>
      </div>
    </div>
  </section>
</BaseLayout>
