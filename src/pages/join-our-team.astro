---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import { BUSINESS, LEAD_ENDPOINT } from "@/consts";
import { breadcrumbNode } from "@/lib/schema";

const crumbs = [
  { name: "Home", url: "/" },
  { name: "Careers", url: "/join-our-team/" },
];
const perks = [
  { icon: "users", title: "Real team, real training", text: "We train every mover to crew-leader level. You'll learn the right way to do the job." },
  { icon: "calendar", title: "Steady, flexible work", text: "Consistent hours with a growing local company — not seasonal temp gigs." },
  { icon: "star", title: "Be part of the best", text: "Join a 4.9-star team that takes pride in customer-first service." },
];
---
<BaseLayout
  title="Careers & Moving Jobs in Utah | Join Utah's Moving and Storage"
  description="Looking for moving jobs in Utah? Join Utah's Moving and Storage — a family-owned, 4.9-star company with real training, steady work, and a customer-first crew."
  path="/join-our-team/"
  schema={[breadcrumbNode(crumbs)]}
>
  <section class="bg-navy-950">
    <Breadcrumbs items={crumbs} dark />
    <div class="container-page pb-14 pt-6">
      <h1 class="text-3xl font-bold text-white sm:text-4xl lg:text-5xl">Join the Utah's Moving and Storage crew</h1>
      <p class="mt-5 max-w-2xl text-lg text-navy-200">We're always looking for hard-working, customer-focused people who take pride in doing things right. No experience required — we train you the right way.</p>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid gap-6 sm:grid-cols-3">
      {perks.map((p) => (
        <div class="rounded-2xl border border-navy-100 bg-white p-6">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-canyon-50 text-canyon-600"><Icon name={p.icon} class="h-6 w-6" /></span>
          <h2 class="mt-4 font-bold">{p.title}</h2>
          <p class="mt-2 text-sm text-navy-600">{p.text}</p>
        </div>
      ))}
    </div>

    <div class="mx-auto mt-14 max-w-2xl rounded-2xl border border-navy-100 bg-white p-7 shadow-sm sm:p-8">
      <h2 class="text-2xl font-bold">Apply now</h2>
      <p class="mt-2 text-navy-600">Tell us a bit about yourself and we'll be in touch.</p>
      <form class="quote-form mt-6 space-y-4" method="POST" action={LEAD_ENDPOINT} data-source="careers">
        <div class="hidden" aria-hidden="true"><label>Leave empty<input type="text" name="company_website" tabindex="-1" /></label></div>
        <input type="hidden" name="source" value="careers-application" />
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="a-name" class="mb-1 block text-sm font-medium text-navy-800">Name *</label>
            <input id="a-name" name="name" type="text" required class="w-full rounded-lg border border-navy-200 px-3.5 py-2.5" placeholder="Your name" />
          </div>
          <div>
            <label for="a-phone" class="mb-1 block text-sm font-medium text-navy-800">Phone *</label>
            <input id="a-phone" name="phone" type="tel" required class="w-full rounded-lg border border-navy-200 px-3.5 py-2.5" placeholder="(801) 555-0123" />
          </div>
        </div>
        <div>
          <label for="a-email" class="mb-1 block text-sm font-medium text-navy-800">Email *</label>
          <input id="a-email" name="email" type="email" required class="w-full rounded-lg border border-navy-200 px-3.5 py-2.5" placeholder="you@example.com" />
        </div>
        <div>
          <label for="a-msg" class="mb-1 block text-sm font-medium text-navy-800">Why do you want to join us?</label>
          <textarea id="a-msg" name="message" rows="4" class="w-full rounded-lg border border-navy-200 px-3.5 py-2.5" placeholder="Tell us about your experience and availability"></textarea>
        </div>
        <button type="submit" class="btn-primary w-full">Submit Application</button>
        <p class="form-status text-sm" role="status" aria-live="polite"></p>
      </form>
      <p class="mt-4 text-center text-sm text-navy-500">Prefer to call? Reach us at <a href={BUSINESS.phoneHref} class="font-semibold text-canyon-700">{BUSINESS.phone}</a>.</p>
    </div>
  </section>
</BaseLayout>
