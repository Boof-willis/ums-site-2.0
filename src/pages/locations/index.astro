---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import CtaBand from "@/components/CtaBand.astro";
import { LOCATIONS, BUSINESS } from "@/consts";
import { breadcrumbNode } from "@/lib/schema";

const crumbs = [
  { name: "Home", url: "/" },
  { name: "Locations", url: "/locations/" },
];
---
<BaseLayout
  title="Moving Service Areas Across the Wasatch Front | Utah Movers"
  description="Utah's Moving and Storage serves Orem, Provo, Salt Lake City, Lehi, Draper, Sandy, West Jordan, Saratoga Springs, Spanish Fork & Park City. Find your city's movers."
  path="/locations/"
  schema={[breadcrumbNode(crumbs)]}
>
  <section class="bg-navy-950">
    <Breadcrumbs items={crumbs} dark />
    <div class="container-page pb-14 pt-6">
      <h1 class="text-3xl font-bold text-white sm:text-4xl lg:text-5xl">Movers serving the entire Wasatch Front</h1>
      <p class="mt-5 max-w-2xl text-lg text-navy-200">Based in {BUSINESS.address.city}, Utah's Moving and Storage proudly serves communities across Utah County and Salt Lake County, plus long-distance moves in and out of the state. Find your city below.</p>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {LOCATIONS.map((l) => (
        <a href={`/locations/${l.slug}/`} class="group flex items-center justify-between gap-3 rounded-2xl border border-navy-100 bg-white p-6 transition-all hover:-translate-y-1 hover:border-canyon-200 hover:shadow-lg">
          <div class="flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-navy-900 text-canyon-400 group-hover:bg-canyon-500 group-hover:text-white"><Icon name="map-pin" class="h-6 w-6" /></span>
            <div>
              <h2 class="font-bold">{l.city}, UT</h2>
              <p class="text-sm text-navy-500">{l.county}</p>
            </div>
          </div>
          <Icon name="arrow" class="h-5 w-5 text-navy-300 transition-transform group-hover:translate-x-1 group-hover:text-canyon-500" />
        </a>
      ))}
    </div>

    <p class="mt-10 text-center text-navy-600">Don't see your city? We likely serve it too, <a href="/quote/" class="font-semibold text-canyon-700 underline">request a free quote</a> or call <a href={BUSINESS.phoneHref} class="font-semibold text-canyon-700 underline">{BUSINESS.phone}</a>.</p>
  </section>

  <CtaBand />
</BaseLayout>
