# Copy to .env (local) or set in Cloudflare Pages → Settings → Environment variables.

# GoHighLevel inbound webhook / form endpoint that receives lead submissions.
# Used by functions/api/quote.ts. Until this is set, the form accepts leads
# and logs them but does not forward them to GHL.
GHL_FORM_ENDPOINT=

# Optional: bearer token if your GHL endpoint requires authorization.
GHL_API_KEY=

# Analytics (optional). Leave blank to render no tracking scripts.
# Cloudflare Web Analytics token (cookieless, no cookie banner needed):
PUBLIC_CF_BEACON_TOKEN=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (fires generate_lead on /thank-you/):
PUBLIC_GA4_ID=
